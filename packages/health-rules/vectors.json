    {
      "name": "healthy laptop, battery at 71 percent",
      "input": {
        "schemaVersion": 1,
        "identity": {
          "hostname": "LAT-7420",
          "model": "Latitude 7420"
        },
        "cpu": {
          "peakTempC": 76,
          "throttled": false,
          "usagePercent": 38
        },
        "memory": {
          "totalBytes": 17179869184,
          "slotsUsed": 2,
          "slotsTotal": 2
        },
        "battery": {
          "designWh": 54.1,
          "fullChargeWh": 38.4
        },
        "storage": [
          {
            "model": "Samsung NVMe",
            "sizeBytes": 512000000000,
            "freeBytes": 300000000000,
            "health": "Healthy",
            "nvme": {
              "percentageUsed": 6,
              "availableSparePercent": 100,
              "criticalWarning": 0,
              "mediaErrors": 0,
              "unsafeShutdowns": 4
            }
          }
        ],
        "security": {
          "defenderEnabled": true,
          "firewallEnabled": true
        }
      },
      "expect": [
        {
          "id": "battery.capacity",
          "severity": "attention",
          "evidenceType": "measured",
          "evidence": {
            "capacityPercent": 71,
            "designCapacityWh": 54.1,
            "fullChargeCapacityWh": 38.4
          }
        },
        {
          "id": "storage.nvme_life.0",
          "severity": "healthy",
          "evidenceType": "measured",
          "evidence": {
            "percentageUsed": 6
          }
        },
        {
          "id": "storage.health.0",
          "severity": "healthy",
          "evidenceType": "measured",
          "evidence": {}
        },
        {
          "id": "cpu.temperature",
          "severity": "healthy",
          "evidenceType": "measured",
          "evidence": {
            "peakTemperatureC": 76
          }
        },
        {
          "id": "memory.capacity",
          "severity": "healthy",
          "evidenceType": "measured",
          "evidence": {
            "installedGB": 16
          }
        },
        {
          "id": "security.defender",
          "severity": "healthy",
          "evidenceType": "measured",
          "evidence": {}
        }
      ]
    },
    {
      "name": "overheating PC with throttling is an inferred cooling finding",
      "input": {
        "schemaVersion": 1,
        "cpu": {
          "peakTempC": 96,
          "throttled": true,
          "usagePercent": 38
        }
      },
      "expect": [

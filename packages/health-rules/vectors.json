        {
          "id": "cpu.throttling",
          "severity": "attention",
          "evidenceType": "inferred",
          "evidence": {
            "peakTemperatureC": 96,
            "thermalThrottling": true,
            "cpuUsagePercent": 38
          }
        }
      ]
    },

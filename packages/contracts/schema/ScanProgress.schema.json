{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source": {
      "type": "string",
      "enum": [
        "desktop",
        "quickcheck",
        "mobile",
        "server"
      ]
    },
    "scanId": {
      "type": "string",
      "maxLength": 60
    },
    "stages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 40
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "state": {
            "type": "string",
            "enum": [
              "waiting",
              "running",
              "done",
              "skipped",
              "failed"
            ]
          },
          "detail": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "label",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "completedStages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalStages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "finished": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "deviceId",
    "timestamp",
    "source",
    "scanId",
    "stages",
    "completedStages",
    "totalStages",
    "finished"
  ],
  "additionalProperties": false
}

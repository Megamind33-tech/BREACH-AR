<Project Sdk="Microsoft.NET.Sdk">
  <!-- Parses every C# file under Assets/ as C# 9 and reports syntax errors.
       Cheap pre-flight for code that can only be fully compiled inside Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
</Project>
